{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "archetype": {
      "type": "string",
      "description": "Which archetype is guiding"
    },
    "title": {
      "type": "string",
      "description": "Conversation topic"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "archetype"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "archetype"
  ]
}